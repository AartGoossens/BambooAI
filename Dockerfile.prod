FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt setuptools gunicorn

# Copy application code
COPY . .
COPY LLM_CONFIG_prod.json ./web_app/LLM_CONFIG.json

# Create necessary directories
RUN mkdir -p web_app/storage/favourites web_app/storage/threads web_app/temp web_app/logs web_app/datasets

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV FLASK_ENV=production

WORKDIR /app/web_app

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--timeout", "120", "app:app"]